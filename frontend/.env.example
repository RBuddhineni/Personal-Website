# Copy this file to .env and fill in real values for local development.
# Gmail App Password (not your regular password) - required for the contact form to send email.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=youraddress@gmail.com
GMAIL_PASS=your16charapppassword

# Optional: MongoDB connection string used by /api/submit to store newsletter emails.
MONGO_URI=

# Optional: port for the local API dev server used by `npm run dev`.
API_PORT=3001
